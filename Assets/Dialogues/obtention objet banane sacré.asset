  m_Name: "obtention objet banane sacr\xE9"
  m_EditorClassIdentifier: 
  unlocksMonkey: 0
  lines:
  - speakerName: 
    texte: "Vous avez obtenu une \"Banane Sacr\xE9e\"."
    speakerHead: {fileID: 0}
  - speakerName: Jim
    texte: "Qu'est-ce que cette banane a de si sp\xE9cial ?\n"
    speakerHead: {fileID: 1080211091511509889, guid: 62da37894dbe462489488d84056ae9f2, type: 3}
  - speakerName: "R\xE4\u2019adz"
    texte: "C'est le Fruit B\xE9ni, source de force pour le gardien de cette grotte."
    speakerHead: {fileID: 4893617752468652791, guid: 7e24a2ff843b00f48aba10cc21dc89f4, type: 3}
  - speakerName: Jim
    texte: "Il \xE9tait uniquement l\xE0 pour la prot\xE9ger ?"
    speakerHead: {fileID: -4254905870569599130, guid: 77faf8507d837a94c90fb11421b3af29, type: 3}
  - speakerName: "R\xE4\u2019adz"
    texte: "On prot\xE8ge toujours ce que l'on ne peut pas remplacer."
    speakerHead: {fileID: -2473965909627216055, guid: 25a9e84ea5c041842b82aee686cbc203, type: 3}

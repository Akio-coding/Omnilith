  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9e2dd9e6680d87241b78c79669bd7f18, type: 3}
  m_Name: "obtention objet coeur de Calam\xE9on"
  m_EditorClassIdentifier: 
  unlocksMonkey: 0
  lines:
  - speakerName: 
    texte: "Vous avez obtenu le \"C\u0153ur de Calam\xE9on\""
    speakerHead: {fileID: 0}
  - speakerName: 'Lore '
    texte: "Calam\xE9on absorbait les catastrophes\u2026 jusqu\u2019\xE0 ce qu\u2019il
      en devienne une."
    speakerHead: {fileID: 0}
  - speakerName: "R\xE4\u2019adz"
    texte: Attends, n'y touche pas !!!
    speakerHead: {fileID: 5137430236869304561, guid: 2dfce1bc76c6843458ad3d80cab4adf6, type: 3}
  - speakerName: Jim
    texte: ...
    speakerHead: {fileID: -4254905870569599130, guid: 77faf8507d837a94c90fb11421b3af29, type: 3}
  - speakerName: "R\xE4\u2019adz"
    texte: "\xC0 la base, le \"C\u0153ur de Calam\xE9on\" pouvait cr\xE9er des catastrophes."
    speakerHead: {fileID: 5137430236869304561, guid: 2dfce1bc76c6843458ad3d80cab4adf6, type: 3}
  - speakerName: Jim
    texte: "Mais l\xE0, il ne se passe rien. Si \xE7a se trouve, c'est juste devenu
      un cristal banal comme tous les autres ?"
    speakerHead: {fileID: 1080211091511509889, guid: 62da37894dbe462489488d84056ae9f2, type: 3}
  - speakerName: "R\xE4\u2019adz"
    texte: "Il a perdu sa puissance d'antan, maintenant il ne fait que l\xE9viter."
    speakerHead: {fileID: 4893617752468652791, guid: 7e24a2ff843b00f48aba10cc21dc89f4, type: 3}
  - speakerName: Jim
    texte: On peut le revendre pour un bon prix.
    speakerHead: {fileID: -4635919162899075175, guid: 0eaa2c1f28dfe1f4da7fa63591b7e78c, type: 3}
  - speakerName: "R\xE4\u2019adz"
    texte: C'est vrai que tu as de grandes poches pour transporter un tel cristal.
    speakerHead: {fileID: 4893617752468652791, guid: 7e24a2ff843b00f48aba10cc21dc89f4, type: 3}
